generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Analysis {
  id                  String    @id @default(uuid())
  requestId           String    @unique @map("request_id")
  analystId           String?   @map("analyst_id")
  debtRatio           Decimal?  @map("debt_ratio") @db.Decimal(5, 2)
  repaymentCapacity   Decimal?  @map("repayment_capacity") @db.Decimal(15, 2)
  monthlyIncome       Decimal?  @map("monthly_income") @db.Decimal(15, 2)
  existingDebts       Decimal?  @map("existing_debts") @db.Decimal(15, 2)
  estimatedMonthly    Decimal?  @map("estimated_monthly") @db.Decimal(15, 2)
  netIncomeAfter      Decimal?  @map("net_income_after") @db.Decimal(15, 2)
  creditScore         Int?      @map("credit_score")
  riskLevel           RiskLevel? @map("risk_level")
  fraudAlert          Boolean   @default(false) @map("fraud_alert")
  fraudDetails        String?   @map("fraud_details")
  recommendation      Recommendation?
  recommendationNotes String?   @map("recommendation_notes")
  narrativeReport     String?   @map("narrative_report")
  aiExplanation       Json?     @map("ai_explanation")
  submittedAt         DateTime? @map("submitted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("analyses")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum Recommendation {
  FAVORABLE
  UNFAVORABLE
  CONDITIONAL
}
