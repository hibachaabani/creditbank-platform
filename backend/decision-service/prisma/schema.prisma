generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Decision {
  id               String       @id @default(uuid())
  requestId        String       @unique @map("request_id")
  analysisId       String?      @map("analysis_id")
  decidedBy        String       @map("decided_by")
  decisionType     DecisionType @map("decision_type")
  approvedAmount   Decimal?     @map("approved_amount") @db.Decimal(15, 2)
  approvedDuration Int?         @map("approved_duration")
  interestRate     Decimal?     @map("interest_rate") @db.Decimal(5, 3)
  monthlyPayment   Decimal?     @map("monthly_payment") @db.Decimal(15, 2)
  conditions       String[]
  refusalReason    String?      @map("refusal_reason")
  refusalDetails   String?      @map("refusal_details")
  signedAt         DateTime?    @map("signed_at")
  decisionLevel    String       @default("MANAGER") @map("decision_level")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@map("decisions")
}

enum DecisionType {
  APPROVED
  REJECTED
  CONDITIONAL
}
